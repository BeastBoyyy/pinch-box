{
  "name": "pinch-box",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.js",
    "test": "node --test",
    "setup": "node tools/setup.js",
    "qa": "node tools/qa.js",
    "e2e": "node tools/e2e.js && node tools/e2e-keys.js",
    "bench": "node tools/bench.js",
    "app": "electron .",
    "dist": "electron-builder --win portable --x64",
    "selftest": "electron . --selftest=12 --selftest-out=qa/selftest.json"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "playwright": "1.64.1",
    "@mediapipe/tasks-vision": "1.1.1"
  },
  "main": "electron/main.mjs",
  "description": "Pinch-Box: draw a box with your hands, pinch to lock it, stack live video effects",
  "author": "Pinch-Box team",
  "build": {
    "appId": "school.pinchbox",
    "productName": "Pinch-Box",
    "asar": false,
    "compression": "store",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "index.html",
      "src/**",
      "tools/serve.js",
      "vendor/**",
      "models/**",
      "fixtures/sample.mp4",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Pinch-Box.exe",
      "unpackDirName": "PinchBox"
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}